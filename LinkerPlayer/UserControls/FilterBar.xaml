<UserControl
  x:Class="LinkerPlayer.UserControls.FilterBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:LinkerPlayer.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:LinkerPlayer.Models"
  d:DesignHeight="120"
  d:DesignWidth="900"
  mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LinkerPlayer;component/Styles/StylesRepository.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--  ListBoxItem style to keep selected highlight visible when control is unfocused  -->
      <Style x:Key="FilterListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>

              <ControlTemplate.Triggers>
                <!--  Selected - works whether the ListBox has focus or not  -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListSelectedItemBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource TrackListSelectedItemForegroundBrush}" />
                </Trigger>

                <!--  Optional: Keep a subtle mouse-over effect when not selected  -->
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListItemMouseOverBrush}" />
                  <!--  Use an existing hover brush if you have one, or define one  -->
                </Trigger>

                <!--  Disabled state  -->
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border
    Padding="8,4"
    Background="{DynamicResource PlaylistTabBackgroundBrush}"
    BorderBrush="{DynamicResource PlaylistTabBorderBrush}"
    BorderThickness="0,0,0,1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--  Keywords Search Row  -->
      <Grid Grid.Row="0" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <!--  Keywords Label  -->

        <iconPacks:PackIconMaterial
          Grid.Column="0"
          Width="18"
          Height="18"
          Margin="4,0,8,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TrackListItemForegroundBrush}"
          Kind="Magnify" />


        <!--  Keywords TextBox with inline help button  -->

        <Grid Grid.Column="1" VerticalAlignment="Center">

          <local:SyntaxSearchBox
            x:Name="KeywordsTextBox"
            MinWidth="200"
            VerticalAlignment="Center"
            Placeholder="Search keywords or query (? for help)..."
            Text="{Binding KeywordSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}"
            ToolTip="Search keywords, or type a query: bitrate &gt; 320 · year &gt; 1980 · genre = jazz · click ? for help" />

          <!--  Query help toggle button — sits inside the right edge of the TextBox  -->
          <Button
            x:Name="QueryHelpButton"
            Width="22"
            Height="22"
            Margin="0,0,3,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="QueryHelpButton_Click"
            Cursor="Hand"
            Focusable="False"
            ToolTip="Query syntax help">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TrackListItemForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border
                        x:Name="Bd"
                        Width="20"
                        Height="20"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListItemMouseOverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListSelectedItemBackgroundBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock
              FontSize="11"
              FontWeight="Bold"
              Foreground="{DynamicResource TrackListItemForegroundBrush}"
              Text="?" />
          </Button>

          <!--  Query syntax help popup  -->
          <Popup
            x:Name="QueryHelpPopup"
            AllowsTransparency="True"
            HorizontalOffset="-320"
            IsOpen="False"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=QueryHelpButton}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="4"
            Width="420">
            <Border
              Padding="14,12"
              Background="{DynamicResource PlaylistTabBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.4" ShadowDepth="4" />
              </Border.Effect>
              <StackPanel>

                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="{DynamicResource FontSizeNormal}"
                  FontWeight="Bold"
                  Foreground="{DynamicResource TrackListItemForegroundBrush}"
                  Text="Query Syntax" />

                <!--  Fields  -->
                <TextBlock
                  Margin="0,0,0,4"
                  FontSize="{DynamicResource FontSizeSmall}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TrackListItemForegroundBrush}"
                  Text="FIELDS" />
                <local:QueryHelpRow Label="title, artist, album, genre" Description="Text fields" />
                <local:QueryHelpRow Label="year  ·  date" Description="Release year (numeric)" />
                <local:QueryHelpRow Label="bitrate  ·  kbps" Description="Bitrate in kbps (numeric)" />
                <local:QueryHelpRow Label="codec  ·  format  ·  ext" Description="File extension / codec" />
                <local:QueryHelpRow Label="performer, composer" Description="Additional text fields" />

                <!--  Operators  -->
                <TextBlock
                  Margin="0,10,0,4"
                  FontSize="{DynamicResource FontSizeSmall}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TrackListItemForegroundBrush}"
                  Text="OPERATORS" />
                <local:QueryHelpRow Label="=  or  ==" Description="Exact match" />
                <local:QueryHelpRow Label="!=" Description="Not equal" />
                <local:QueryHelpRow Label="contains  or  ~" Description="Text contains" />
                <local:QueryHelpRow Label="&gt;  &gt;=  &lt;  &lt;=" Description="Numeric comparison" />
                <local:QueryHelpRow Label="OR  ·  ||  ·  |" Description="Either condition" />

                <!--  Examples  -->
                <TextBlock
                  Margin="0,10,0,4"
                  FontSize="{DynamicResource FontSizeSmall}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TrackListItemForegroundBrush}"
                  Text="EXAMPLES" />
                <local:QueryHelpRow Label="bitrate &gt; 320" Description="High-quality tracks" />
                <local:QueryHelpRow Label="year &gt; 1960 &lt; 1990" Description="Tracks from the 60s–80s" />
                <local:QueryHelpRow Label="genre = jazz OR genre = blues" Description="Jazz or blues" />
                <local:QueryHelpRow Label="artist contains miles" Description="Artist name contains 'miles'" />
                <local:QueryHelpRow Label="bitrate &gt;= 192 genre = jazz" Description="Both must match (AND)" />
                <local:QueryHelpRow Label="metallica" Description="Plain text search (no operator)" />

              </StackPanel>
            </Border>
          </Popup>

        </Grid>


        <!--  Clear All Button  -->

        <Button
          x:Name="ClearAllButton"
          Grid.Column="2"
          Width="80"
          Height="28"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Click="ClearAllButton_Click"
          Content="Clear All"
          FontSize="{DynamicResource FontSizeNormal}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Clear all filters and keyword search" />


        <!--  Save Changes Button (always present, enabled only when edits are pending)  -->

        <Button
          x:Name="SaveChangesButton"
          Grid.Column="3"
          Width="80"
          Height="28"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding DataContext.SaveDirtyTracksCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
          Content="Save"
          FontSize="{DynamicResource FontSizeNormal}"
          IsEnabled="{Binding DataContext.HasDirtyTracks, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Save edited metadata to file and database" />


        <!--  Add Filter Button  -->

        <!--<Button
          x:Name="AddFilterButton"
          Grid.Column="3"
          Width="28"
          Height="28"
          Margin="4,0,0,0"
          VerticalAlignment="Center"
          Click="AddFilterButton_Click"
          FontSize="{DynamicResource FontSizeNormal}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Add a new filter">
          <iconPacks:PackIconMaterial
            Width="16"
            Height="16"
            Foreground="{DynamicResource ControlForegroundBrush}"
            Kind="FilterPlus" />
        </Button>-->
      </Grid>

      <!--  Simpler Filter UI: four cascading ListBoxes for Genre, Artist, Album, Codec  -->
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <!--  Genres  -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Genres (" />
            <Run Text="{Binding GenreCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="GenresListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Genres}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="GenresList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>

        <!--  Artists  -->
        <Grid Grid.Column="1" Margin="0,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Artists (" />
            <Run Text="{Binding ArtistCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="ArtistsListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Artists}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="ArtistsList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>

        <!--  Albums  -->
        <Grid Grid.Column="2" Margin="0,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Albums (" />
            <Run Text="{Binding AlbumCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="AlbumsListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Albums}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="AlbumsList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>

        <!--  Codecs  -->
        <Grid Grid.Column="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Codec (" />
            <Run Text="{Binding CodecCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="CodecsListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Codecs}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="CodecsList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
