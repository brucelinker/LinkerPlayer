<UserControl
  x:Class="LinkerPlayer.UserControls.FilterBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:LinkerPlayer.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:LinkerPlayer.Models"
  d:DesignHeight="120"
  d:DesignWidth="900"
  mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LinkerPlayer;component/Styles/StylesRepository.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--  ListBoxItem style to keep selected highlight visible when control is unfocused  -->
      <Style x:Key="FilterListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>

              <ControlTemplate.Triggers>
                <!--  Selected - works whether the ListBox has focus or not  -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListSelectedItemBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource TrackListSelectedItemForegroundBrush}" />
                </Trigger>

                <!--  Optional: Keep a subtle mouse-over effect when not selected  -->
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackListItemMouseOverBrush}" />
                  <!--  Use an existing hover brush if you have one, or define one  -->
                </Trigger>

                <!--  Disabled state  -->
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border
    Padding="8,4"
    Background="{DynamicResource PlaylistTabBackgroundBrush}"
    BorderBrush="{DynamicResource PlaylistTabBorderBrush}"
    BorderThickness="0,0,0,1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--  Keywords Search Row  -->
      <Grid Grid.Row="0" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <!--  Keywords Label  -->

        <iconPacks:PackIconMaterial
          Grid.Column="0"
          Width="18"
          Height="18"
          Margin="4,0,8,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TrackListItemForegroundBrush}"
          Kind="Magnify" />


        <!--  Keywords TextBox  -->

        <TextBox
          x:Name="KeywordsTextBox"
          Grid.Column="1"
          MinWidth="200"
          Padding="6,4"
          VerticalAlignment="Center"
          FontSize="{DynamicResource FontSizeNormal}"
          Text="{Binding KeywordSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}"
          ToolTip="Search across all track metadata (Artist, Album, Title, Genre, etc.)">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TrackListItemForegroundBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
          </TextBox.Style>
          <i:Interaction.Behaviors>
            <local:TextBoxWatermarkBehavior Foreground="{DynamicResource TrackListItemForegroundBrush}" Text="Search keywords or title..." />
          </i:Interaction.Behaviors>
        </TextBox>


        <!--  Clear All Button  -->

        <Button
          x:Name="ClearAllButton"
          Grid.Column="2"
          Width="80"
          Height="28"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Click="ClearAllButton_Click"
          Content="Clear All"
          FontSize="{DynamicResource FontSizeNormal}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Clear all filters and keyword search" />


        <!--  Save Changes Button (always present, enabled only when edits are pending)  -->

        <Button
          x:Name="SaveChangesButton"
          Grid.Column="3"
          Width="80"
          Height="28"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding DataContext.SaveDirtyTracksCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
          Content="Save"
          FontSize="{DynamicResource FontSizeNormal}"
          IsEnabled="{Binding DataContext.HasDirtyTracks, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Save edited metadata to file and database" />


        <!--  Add Filter Button  -->

        <!--<Button
          x:Name="AddFilterButton"
          Grid.Column="3"
          Width="28"
          Height="28"
          Margin="4,0,0,0"
          VerticalAlignment="Center"
          Click="AddFilterButton_Click"
          FontSize="{DynamicResource FontSizeNormal}"
          Style="{StaticResource LinkerRectangleButton}"
          ToolTip="Add a new filter">
          <iconPacks:PackIconMaterial
            Width="16"
            Height="16"
            Foreground="{DynamicResource ControlForegroundBrush}"
            Kind="FilterPlus" />
        </Button>-->
      </Grid>

      <!--  Simpler Filter UI: three cascading ListBoxes for Genre, Artist, Album  -->
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Genres  -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Genres (" />
            <Run Text="{Binding GenreCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="GenresListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Genres}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="GenresList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>

        <!--  Artists  -->
        <Grid Grid.Column="1" Margin="0,0,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Artists (" />
            <Run Text="{Binding ArtistCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="ArtistsListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Artists}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="ArtistsList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>

        <!--  Albums  -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}">
            <Run Text="Albums (" />
            <Run Text="{Binding AlbumCount, Mode=OneWay}" />
            <Run Text=")" />
          </TextBlock>
          <ListBox
            x:Name="AlbumsListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PlaylistTabBackgroundBrush}"
            FontSize="12"
            FontWeight="Normal"
            Foreground="{DynamicResource TrackListItemForegroundBrush}"
            ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
            ItemsSource="{Binding Albums}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="AlbumsList_SelectionChanged"
            SelectionMode="Extended" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
