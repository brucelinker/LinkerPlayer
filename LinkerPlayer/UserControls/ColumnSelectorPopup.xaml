<UserControl
  x:Class="LinkerPlayer.UserControls.ColumnSelectorPopup"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  BorderBrush="{DynamicResource PlaylistTabBackgroundBrush}"
  BorderThickness="1">

    <Grid Background="{DynamicResource PlaylistTabBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Margin="10,4,4,8"
      FontWeight="SemiBold"
      Text="Select columns" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox
              Margin="14,6"
              Content="{Binding DisplayName}"
              Foreground="{DynamicResource TrackListSelectedItemForegroundBrush}"
              IsChecked="{Binding IsVisible, Mode=TwoWay}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel
      Grid.Row="2"
      Margin="0,8,0,0"
      HorizontalAlignment="Center"
      Orientation="Horizontal">
      <Button
        MinWidth="70"
        Margin="0,0,8,8"
        Padding="8,4"
        Command="{Binding ConfirmSelectionCommand}"
        Content="OK" />
    </StackPanel>
  </Grid>
</UserControl>
