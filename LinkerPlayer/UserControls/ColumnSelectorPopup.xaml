<UserControl
  x:Class="LinkerPlayer.UserControls.ColumnSelectorPopup"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  MinWidth="140"
  MinHeight="200"
  BorderBrush="{DynamicResource PlaylistTabBackgroundBrush}"
  BorderThickness="1">

  <Grid Background="{DynamicResource PlaylistTabBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Margin="10,4,4,8"
      FontSize="14"
      FontWeight="SemiBold"
      Foreground="{DynamicResource TrackListSelectedItemForegroundBrush}"
      Text="Select columns" />

    <ScrollViewer
      Grid.Row="1"
      HorizontalAlignment="Center"
      VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox
              Margin="6,6,6,0"
              Content="{Binding DisplayName}"
              Foreground="{DynamicResource TrackListSelectedItemForegroundBrush}"
              IsChecked="{Binding IsVisible, Mode=TwoWay}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel
      Grid.Row="2"
      Margin="0,8,0,0"
      HorizontalAlignment="Center"
      Orientation="Horizontal">
      <Button
        Name="CloseButton"
        Height="25"
        MinWidth="80"
        Margin="0,10,0,10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Command="{Binding ConfirmSelectionCommand}"
        Content="Close"
        FontSize="{DynamicResource FontSizeButton}"
        FontWeight="Normal"
        Foreground="{DynamicResource ControlForegroundBrush}"
        Style="{StaticResource LinkerRectangleButton}" />
    </StackPanel>
  </Grid>
</UserControl>
