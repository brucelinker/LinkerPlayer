<UserControl
  x:Class="LinkerPlayer.UserControls.PlaylistTabs"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:converters="clr-namespace:LinkerPlayer.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:LinkerPlayer"
  xmlns:managedBass="clr-namespace:ManagedBass;assembly=ManagedBass"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:LinkerPlayer.Models"
  xmlns:userControls="clr-namespace:LinkerPlayer.UserControls"
  d:DesignHeight="80"
  d:DesignWidth="800"
  mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LinkerPlayer;component/Styles/StylesRepository.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:DurationConverter x:Key="DurationConverter" />
      <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
      <converters:ActiveTrackStateToVisibilityConverter x:Key="ActiveTrackStateToVisibilityConverter" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:ZeroToEmptyConverter x:Key="ZeroToEmptyConverter" />
      <converters:StringEqualityToVisibilityConverter x:Key="StringEqualityToVisibilityConverter" />
      <!--  Album-cover indicator column cell template (Library only)  -->
      <!--  Lightweight: a ToolTip replaces the per-row Popup so no popup visual tree is  -->
      <!--  realized per row during scroll; the cover still loads lazily on hover.  -->
      <DataTemplate x:Key="AlbumCoverCellTemplate">
        <Border
          x:Name="AlbumCoverBorder"
          Width="24"
          Height="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="Transparent"
          MouseEnter="AlbumCoverHover_MouseEnter">
          <Border.ToolTip>
            <ToolTip x:Name="AlbumCoverToolTip">
              <Border
                Width="240"
                Height="240"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1">
                <Image Source="{Binding AlbumCover}" Stretch="Uniform" />
              </Border>
            </ToolTip>
          </Border.ToolTip>
          <iconPacks:PackIconMaterial
            Width="12"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource TrackListItemForegroundBrush}"
            Kind="ImageOutline"
            Visibility="{Binding HasEmbeddedCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="PlayPauseCellTemplate">
        <Grid>
          <!--  Badge for items that still need metadata refresh (quick-imported)  -->
          <iconPacks:PackIconMaterial
            Width="10"
            Height="10"
            Margin="2,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Foreground="OrangeRed"
            Kind="AlertCircle"
            ToolTip="Needs metadata refresh"
            Visibility="{Binding NeedsMetadataRefresh, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <iconPacks:PackIconFontAwesome
            Width="20"
            Height="10"
            Margin="5,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{StaticResource TrackListItemForegroundBrush}"
            Kind="PlaySolid">
            <iconPacks:PackIconFontAwesome.Visibility>
              <MultiBinding Converter="{StaticResource ActiveTrackStateToVisibilityConverter}" ConverterParameter="{x:Static managedBass:PlaybackState.Playing}">
                <Binding Path="Id" />
                <Binding Path="DataContext.ActiveTrackId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                <Binding Path="DataContext.State" RelativeSource="{RelativeSource AncestorType=UserControl}" />
              </MultiBinding>
            </iconPacks:PackIconFontAwesome.Visibility>
          </iconPacks:PackIconFontAwesome>
          <!--  Spinner while a background metadata refresh is active  -->
          <Grid
            Width="16"
            Height="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse
              Width="16"
              Height="16"
              Opacity="0.6"
              Stroke="LightGray"
              StrokeThickness="2" />
            <Ellipse
              Width="10"
              Height="10"
              Stroke="Orange"
              StrokeThickness="2">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="rt" Angle="0" CenterX="5" CenterY="5" />
              </Ellipse.RenderTransform>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation
                        Storyboard.TargetName="rt"
                        Storyboard.TargetProperty="Angle"
                        From="0"
                        To="360"
                        Duration="0:0:1" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
          </Grid>

          <iconPacks:PackIconMaterial
            Width="20"
            Height="10"
            Margin="5,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{StaticResource TrackListItemForegroundBrush}"
            Kind="Pause">
            <iconPacks:PackIconMaterial.Visibility>
              <MultiBinding Converter="{StaticResource ActiveTrackStateToVisibilityConverter}" ConverterParameter="{x:Static managedBass:PlaybackState.Paused}">
                <Binding Path="Id" />
                <Binding Path="DataContext.ActiveTrackId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                <Binding Path="DataContext.State" RelativeSource="{RelativeSource AncestorType=UserControl}" />
              </MultiBinding>
            </iconPacks:PackIconMaterial.Visibility>
          </iconPacks:PackIconMaterial>
        </Grid>
      </DataTemplate>

      <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource PlaylistTabBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlaylistTabBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style TargetType="{x:Type userControls:CachingTabControl}">
        <Setter Property="Background" Value="{DynamicResource PlaylistTabBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlaylistTabBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type userControls:CachingTabControl}">
              <Grid
                Background="{TemplateBinding Background}"
                ClipToBounds="True"
                KeyboardNavigation.TabNavigation="Local"
                SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabPanel
                  x:Name="HeaderPanel"
                  Grid.Row="0"
                  Margin="0,0,4,-1"
                  Panel.ZIndex="1"
                  IsItemsHost="True"
                  KeyboardNavigation.TabIndex="1" />
                <Border
                  Grid.Row="1"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  KeyboardNavigation.DirectionalNavigation="Contained"
                  KeyboardNavigation.TabIndex="2"
                  KeyboardNavigation.TabNavigation="Local">
                  <Grid x:Name="PART_SelectedContentHost" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource PlaylistTabBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0" />
      </Style>

      <Style x:Key="EditableTabHeaderControl" TargetType="{x:Type userControls:EditableTabHeaderControl}">
        <Setter Property="Background" Value="{DynamicResource PlaylistTabBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PlaylistTabForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type userControls:EditableTabHeaderControl}">
              <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBox
                    x:Name="PART_TabHeader"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="White"
                    Foreground="Black"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
                  <TextBlock
                    x:Name="PART_TextBlock"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Foreground="{TemplateBinding Foreground}"
                    Text="{Binding Name, Mode=TwoWay}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsInEditMode" Value="True">
                  <Setter TargetName="PART_TabHeader" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PART_TextBlock" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=IsSelected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource PlaylistTabSelectedBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border
                Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource MenuDisabledBrush}"
                BorderThickness="1"
                CornerRadius="1"
                Opacity="1">
                <StackPanel
                  Margin="0"
                  ClipToBounds="True"
                  IsItemsHost="True"
                  Opacity="1"
                  Orientation="Vertical" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  Music Library Tab Header Template (Icon-based, no editing/dragging)  -->
      <DataTemplate x:Key="MusicLibraryHeaderTemplate">
        <Grid
          Margin="0"
          Background="Transparent"
          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <Grid.ContextMenu>
            <ContextMenu>
              <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist" />
              <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistFromFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist From Folder" />
              <MenuItem Command="{Binding PlacementTarget.Tag.LoadPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Load Playlist" />
              <Separator />
              <MenuItem Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Add Folder to Library" />
              <MenuItem Command="{Binding PlacementTarget.Tag.AddFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Add Files to Library" />
            </ContextMenu>
          </Grid.ContextMenu>
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial
              Width="16"
              Height="16"
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Kind="Database">
              <iconPacks:PackIconMaterial.Style>
                <Style TargetType="iconPacks:PackIconMaterial">
                  <Setter Property="Foreground" Value="{DynamicResource PlaylistTabForegroundBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </iconPacks:PackIconMaterial.Style>
            </iconPacks:PackIconMaterial>
            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeNormal}">
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text=" (" />
              <Run Text="{Binding FilteredTrackCount, Mode=OneWay}" />
              <Run Text=")" />
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource PlaylistTabForegroundBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!--  Speaker icon for Library tab when it's the active playback source  -->
            <iconPacks:PackIconMaterial
              Margin="0,0,0,0"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource PlaylistTabForegroundBrush}"
              Kind="VolumeHigh">
              <iconPacks:PackIconMaterial.Visibility>
                <MultiBinding Converter="{StaticResource StringEqualityToVisibilityConverter}">
                  <Binding Path="DataContext.ActiveTabName" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                  <Binding Source="Music Library" />
                </MultiBinding>
              </iconPacks:PackIconMaterial.Visibility>
              <iconPacks:PackIconMaterial.Style>
                <Style TargetType="iconPacks:PackIconMaterial">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </iconPacks:PackIconMaterial.Style>
            </iconPacks:PackIconMaterial>
          </StackPanel>
        </Grid>
      </DataTemplate>

      <!--  Playlist Tab Header Template (Editable text, draggable)  -->
      <DataTemplate x:Key="PlaylistHeaderTemplate">
        <StackPanel Orientation="Horizontal">
          <userControls:EditableTabHeaderControl
            Margin="0"
            Padding="0"
            AllowDrop="True"
            DragLeave="TabItem_DragLeave"
            DragOver="TabItem_DragOver"
            Drop="TabItem_Drop"
            PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
            PreviewMouseMove="TabItem_PreviewMouseMove"
            Style="{StaticResource EditableTabHeaderControl}"
            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <userControls:EditableTabHeaderControl.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist" />
                <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistFromFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist From Folder" />
                <MenuItem Command="{Binding PlacementTarget.Tag.LoadPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Load Playlist" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Add Folder" />
                <MenuItem Command="{Binding PlacementTarget.Tag.AddFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Add Files" />
                <Separator />
                <MenuItem
                  Command="{Binding PlacementTarget.Tag.BeginRenameTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Header="Rename Playlist" />
                <Separator />
                <MenuItem
                  Command="{Binding PlacementTarget.Tag.RemovePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Header="Remove Playlist" />
              </ContextMenu>
            </userControls:EditableTabHeaderControl.ContextMenu>
            <userControls:EditableTabHeaderControl.Content>
              <Binding Mode="TwoWay" Path="Name" />
            </userControls:EditableTabHeaderControl.Content>
          </userControls:EditableTabHeaderControl>
          <TextBlock
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeNormal}">
            <Run Text=" (" />
            <Run Text="{Binding Tracks.Count, Mode=OneWay}" />
            <Run Text=")" />
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PlaylistTabForegroundBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!--  Speaker icon shows this tab is the active playback source  -->
          <iconPacks:PackIconMaterial
            Margin="6,0,0,0"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="{DynamicResource PlaylistTabForegroundBrush}"
            Kind="VolumeHigh">
            <iconPacks:PackIconMaterial.Visibility>
              <MultiBinding Converter="{StaticResource StringEqualityToVisibilityConverter}">
                <Binding Path="DataContext.ActiveTabName" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                <Binding Path="Name" />
              </MultiBinding>
            </iconPacks:PackIconMaterial.Visibility>
            <iconPacks:PackIconMaterial.Style>
              <Style TargetType="iconPacks:PackIconMaterial">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PlaylistTabSelectedForegroundBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </iconPacks:PackIconMaterial.Style>
          </iconPacks:PackIconMaterial>

        </StackPanel>
      </DataTemplate>

      <!--  Tab Header Template Selector  -->
      <userControls:TabHeaderTemplateSelector
        x:Key="TabHeaderTemplateSelector"
        MusicLibraryTemplate="{StaticResource MusicLibraryHeaderTemplate}"
        PlaylistTemplate="{StaticResource PlaylistHeaderTemplate}" />

      <Style x:Key="TabItemContainerStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource PlaylistTabBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border
                x:Name="TabBorder"
                Padding="12,3,12,3"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource PlaylistTabBorderBrush}"
                BorderThickness="1,1,1,0">
                <ContentPresenter
                  x:Name="Content"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ContentSource="Header" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PlaylistTabSelectedBackgroundBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplateSelector" Value="{StaticResource TabHeaderTemplateSelector}" />
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
        <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove" />
        <EventSetter Event="DragOver" Handler="TabItem_DragOver" />
        <EventSetter Event="DragLeave" Handler="TabItem_DragLeave" />
        <EventSetter Event="Drop" Handler="TabItem_Drop" />
      </Style>

      <Style TargetType="MenuItem">
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBackgroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4" />

        <!--  Default = simple look for normal items  -->
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1">
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  ContentSource="Header"
                  RecognizesAccessKey="True" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>

        <Style.Triggers>
          <!--  When this item has a submenu, switch to a real submenu-capable template  -->
          <Trigger Property="Role" Value="SubmenuHeader">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                  <Border
                    x:Name="templateRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <ContentPresenter
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True" />

                      <!--  Little arrow  -->
                      <Path
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Data="M 0,0 L 4,3.5 L 0,7 Z"
                        Fill="{TemplateBinding Foreground}" />

                      <!--  The actual submenu popup  -->
                      <Popup
                        x:Name="PART_Popup"
                        AllowsTransparency="True"
                        Focusable="False"
                        IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Right"
                        PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                        <Border
                          Padding="1"
                          Background="{DynamicResource MenuBackgroundBrush}"
                          BorderBrush="{DynamicResource MenuBackgroundBrush}"
                          BorderThickness="1">
                          <!--  No ScrollViewer = no gray scrollbar track  -->
                          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                      </Popup>
                    </Grid>
                  </Border>

                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource MenuMouseOverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource MenuDisabledBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>

          <!--  Your original hover / disabled triggers  -->
          <Trigger Property="IsHighlighted" Value="True">
            <Setter Property="Background" Value="{DynamicResource MenuMouseOverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuMouseOverForegroundBrush}" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource MenuMouseOverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuMouseOverForegroundBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{DynamicResource MenuDisabledBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!--  Music Library Tab Content Template (FilterBar + DataGrid)  -->
      <DataTemplate x:Key="MusicLibraryContentTemplate" DataType="{x:Type models:LibraryTab}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="120" />
            <RowDefinition Height="4" />
            <RowDefinition Height="3*" />
          </Grid.RowDefinitions>

          <!--  Filter Bar  -->
          <userControls:FilterBar Grid.Row="0" DataContext="{Binding}" />

          <!--  Horizontal Splitter  -->
          <GridSplitter
            Grid.Row="1"
            Height="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            local:GridSplitterPersistence.PersistKey="LibraryFilterSplitter"
            Background="{DynamicResource PlaylistTabBorderBrush}"
            ResizeDirection="Rows" />

          <!--  Track List DataGrid  -->
          <DataGrid
            Name="MusicLibraryDataGrid"
            Grid.Row="2"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AlternationCount="2"
            AutoGenerateColumns="False"
            Background="Transparent"
            BeginningEdit="MusicLibraryDataGrid_BeginningEdit"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="True"
            CellEditEnding="MusicLibraryDataGrid_CellEditEnding"
            CellStyle="{StaticResource SharedDataGridCellStyle}"
            ColumnHeaderStyle="{StaticResource SharedDataGridColumnHeaderStyle}"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Visible"
            IsReadOnly="False"
            IsSynchronizedWithCurrentItem="False"
            ItemsSource="{Binding TracksView.View}"
            Loaded="DataGrid_Loaded"
            LoadingRow="DataGrid_LoadingRow"
            MouseDoubleClick="PlaylistRow_MouseDoubleClick"
            PreviewMouseLeftButtonDown="MusicLibraryDataGrid_PreviewMouseLeftButtonDown"
            PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
            RowHeaderWidth="34"
            RowHeight="20"
            RowStyle="{StaticResource PlaylistDataGridRowStyle}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.ScrollChanged="PlaylistDataGrid_ScrollChanged"
            SelectedItem="{Binding SelectedMediaFile, Mode=TwoWay}"
            SelectionChanged="TracksTable_OnSelectionChanged"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            Sorting="MusicLibraryDataGrid_Sorting"
            Style="{StaticResource SharedDataGridStyle}"
            ToolTipService.IsEnabled="True"
            VerticalScrollBarVisibility="Visible"
            VirtualizingPanel.CacheLength="1"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Resources>
              <!--  Apply custom scrollbars implicitly within the DataGrid scope  -->
              <Style BasedOn="{StaticResource CustomScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
            </DataGrid.Resources>

            <DataGrid.Tag>
              <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
            </DataGrid.Tag>

            <!--  Same columns as PlaylistTab for now - can be customized later  -->
            <DataGrid.Columns>
              <!--  Columns will be dynamically generated based on MusicLibraryTab.VisibleColumns  -->
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Play" />
                <MenuItem Command="{Binding PlacementTarget.Tag.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Delete from Library" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.RescanSelectedTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Rescan Track(s)" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.AnalyzeSilenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Analyze Silence" />
                <MenuItem Command="{Binding PlacementTarget.Tag.CancelAnalyzeSilenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Cancel Analyze" />
                <MenuItem Command="{Binding PlacementTarget.Tag.ClearSilenceAnalysisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Clear Silence Analysis" />
                <Separator />
                <MenuItem Header="ReplayGain">
                  <MenuItem Command="{Binding PlacementTarget.Tag.AnalyzeReplayGainTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Analyze by Track" />
                  <MenuItem Command="{Binding PlacementTarget.Tag.AnalyzeReplayGainAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Analyze by Album" />
                  <Separator />
                  <MenuItem Command="{Binding PlacementTarget.Tag.RemoveReplayGainAnalysisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Remove ReplayGain analysis" />
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.GetRatingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Get MusicBrainz Ratings" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Properties" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>
      </DataTemplate>

      <!--  Playlist Tab Content Template (DataGrid only)  -->
      <DataTemplate x:Key="PlaylistContentTemplate" DataType="{x:Type models:PlaylistTab}">
        <Grid>
          <!--  Loading overlay — visible while IsLoading=true  -->
          <Grid Panel.ZIndex="10" Background="{DynamicResource PlaylistTabBackgroundBrush}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <StackPanel
              Width="360"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
              <TextBlock
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource PlaylistTabForegroundBrush}"
                Text="{Binding LoadingStatus}" />
              <ProgressBar
                Height="6"
                Maximum="{Binding LoadingTotal}"
                Minimum="0"
                Value="{Binding LoadingProgress}" />
              <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource PlaylistTabForegroundBrush}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="LoadingProgress" />
                    <Binding Path="LoadingTotal" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Grid>
          <DataGrid
            Name="PlaylistDataGrid"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AllowDrop="True"
            AlternationCount="2"
            AutoGenerateColumns="False"
            Background="Transparent"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="True"
            CellStyle="{StaticResource SharedDataGridCellStyle}"
            ColumnHeaderStyle="{StaticResource SharedDataGridColumnHeaderStyle}"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Visible"
            IsReadOnly="True"
            IsSynchronizedWithCurrentItem="False"
            ItemsSource="{Binding Tracks}"
            Loaded="DataGrid_Loaded"
            LoadingRow="DataGrid_LoadingRow"
            MouseDoubleClick="PlaylistRow_MouseDoubleClick"
            PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
            RowHeaderWidth="34"
            RowHeight="20"
            RowStyle="{StaticResource PlaylistDataGridRowStyle}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.ScrollChanged="PlaylistDataGrid_ScrollChanged"
            SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
            SelectedItem="{Binding SelectedMediaFile, Mode=TwoWay}"
            SelectionChanged="TracksTable_OnSelectionChanged"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            Style="{StaticResource SharedDataGridStyle}"
            ToolTipService.IsEnabled="True"
            VerticalScrollBarVisibility="Visible"
            VirtualizingPanel.CacheLength="1"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Resources>
              <!--  Apply custom scrollbars implicitly within the DataGrid scope  -->
              <Style BasedOn="{StaticResource CustomScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
            </DataGrid.Resources>

            <DataGrid.Tag>
              <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
            </DataGrid.Tag>

            <b:Interaction.Triggers>
              <b:EventTrigger EventName="DragOver">
                <b:InvokeCommandAction Command="{Binding DataContext.DragOverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" PassEventArgsToCommand="True" />
              </b:EventTrigger>
              <b:EventTrigger EventName="Drop">
                <b:InvokeCommandAction Command="{Binding DataContext.DropCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" PassEventArgsToCommand="True" />
              </b:EventTrigger>
            </b:Interaction.Triggers>

            <DataGrid.Columns>
              <DataGridTemplateColumn
                Width="40"
                MinWidth="{DynamicResource TrackTableImageSize}"
                Header="Playing">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <iconPacks:PackIconFontAwesome
                        x:Name="PlayImage"
                        Width="20"
                        Height="10"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TrackListItemForegroundBrush}"
                        Kind="PlaySolid">
                        <iconPacks:PackIconFontAwesome.Visibility>
                          <MultiBinding Converter="{StaticResource ActiveTrackStateToVisibilityConverter}" ConverterParameter="{x:Static managedBass:PlaybackState.Playing}">
                            <Binding Path="Id" />
                            <Binding Path="DataContext.ActiveTrackId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="DataContext.State" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </iconPacks:PackIconFontAwesome.Visibility>
                      </iconPacks:PackIconFontAwesome>
                      <iconPacks:PackIconMaterial
                        x:Name="PauseImage"
                        Width="20"
                        Height="10"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TrackListItemForegroundBrush}"
                        Kind="Pause">
                        <iconPacks:PackIconMaterial.Visibility>
                          <MultiBinding Converter="{StaticResource ActiveTrackStateToVisibilityConverter}" ConverterParameter="{x:Static managedBass:PlaybackState.Paused}">
                            <Binding Path="Id" />
                            <Binding Path="DataContext.ActiveTrackId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="DataContext.State" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </iconPacks:PackIconMaterial.Visibility>
                      </iconPacks:PackIconMaterial>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                Width="51"
                Header="Track"
                SortMemberPath="Track">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="5,0,5,0"
                      HorizontalAlignment="Right"
                      d:DataContext="{d:DesignData IMediaFile}"
                      FontSize="{DynamicResource FontSizeNormal}"
                      Text="{Binding Track, Converter={StaticResource ZeroToEmptyConverter}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                Width="300"
                Header="Title"
                SortMemberPath="Title">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="5,0,5,0"
                      d:DataContext="{d:DesignData IMediaFile}"
                      Text="{Binding Title, Mode=OneWay}"
                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                Width="200"
                Header="Artist"
                SortMemberPath="Artist">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="5,0,5,0"
                      d:DataContext="{d:DesignData IMediaFile}"
                      Text="{Binding Artist, FallbackValue='Unknown Artist'}"
                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                Width="300"
                Header="Album"
                SortMemberPath="Album">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="5,0,5,0"
                      d:DataContext="{d:DesignData IMediaFile}"
                      Text="{Binding Album, FallbackValue='Unknown Album'}"
                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                Width="72"
                Header="Duration"
                SortMemberPath="Duration">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="5,0,5,0"
                      HorizontalAlignment="Right"
                      d:DataContext="{d:DesignData MediaFile}"
                      Text="{Binding Duration, Converter={StaticResource DurationConverter}, FallbackValue=Loading...}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Play" />
                <MenuItem Command="{Binding PlacementTarget.Tag.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Remove" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.RescanSelectedTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Rescan Track(s)" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.AnalyzeSilenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Analyze Silence" />
                <MenuItem Command="{Binding PlacementTarget.Tag.CancelAnalyzeSilenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Cancel Analyze" />
                <MenuItem Command="{Binding PlacementTarget.Tag.ClearSilenceAnalysisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Clear Silence Analysis" />
                <Separator />
                <MenuItem Command="{Binding PlacementTarget.Tag.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Properties" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>
      </DataTemplate>

      <!--  Tab Content Template Selector  -->
      <userControls:TabContentTemplateSelector
        x:Key="TabContentTemplateSelector"
        MusicLibraryContentTemplate="{StaticResource MusicLibraryContentTemplate}"
        PlaylistContentTemplate="{StaticResource PlaylistContentTemplate}" />

    </ResourceDictionary>
  </UserControl.Resources>

  <Grid AllowDrop="True">

    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <userControls:CachingTabControl
      x:Name="Tabs123"
      Grid.Row="0"
      Margin="0"
      Padding="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Background="{DynamicResource PlaylistTabBackgroundBrush}"
      BorderThickness="0"
      ItemContainerStyle="{StaticResource TabItemContainerStyle}"
      ItemsSource="{Binding TabList}"
      SelectedIndex="{Binding SelectedTabIndex}">
      <userControls:CachingTabControl.ContentTemplateSelector>
        <StaticResource ResourceKey="TabContentTemplateSelector" />
      </userControls:CachingTabControl.ContentTemplateSelector>
      <userControls:CachingTabControl.Tag>
        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
      </userControls:CachingTabControl.Tag>
      <userControls:CachingTabControl.ContextMenu>
        <ContextMenu>
          <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist" />
          <MenuItem Command="{Binding PlacementTarget.Tag.NewPlaylistFromFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="New Playlist From Folder" />
          <MenuItem Command="{Binding PlacementTarget.Tag.LoadPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Load Playlist" />
        </ContextMenu>
      </userControls:CachingTabControl.ContextMenu>
    </userControls:CachingTabControl>
  </Grid>

</UserControl>
