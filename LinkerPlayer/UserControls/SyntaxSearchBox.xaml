<UserControl
  x:Class="LinkerPlayer.UserControls.SyntaxSearchBox"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="30"
  d:DesignWidth="400"
  mc:Ignorable="d">

  <RichTextBox
    x:Name="RichBox"
    Padding="6,3,28,3"
    VerticalAlignment="Center"
    VerticalContentAlignment="Center"
    AcceptsReturn="False"
    AcceptsTab="False"
    FontSize="{DynamicResource FontSizeNormal}"
    IsDocumentEnabled="False">
    <RichTextBox.Style>
      <Style TargetType="RichTextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TrackListItemForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource TrackListItemForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TrackListSelectedItemBackgroundBrush}" />
      </Style>
    </RichTextBox.Style>
  </RichTextBox>

</UserControl>
