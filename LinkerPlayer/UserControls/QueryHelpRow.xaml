<UserControl
  x:Class="LinkerPlayer.UserControls.QueryHelpRow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d">

  <Grid Margin="0,1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock
      x:Name="LabelText"
      Grid.Column="0"
      Padding="4,2"
      FontFamily="Consolas, Courier New"
      FontSize="11"
      Foreground="{DynamicResource TrackListSelectedItemBackgroundBrush}"
      Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextWrapping="NoWrap" />

    <TextBlock
      x:Name="DescriptionText"
      Grid.Column="1"
      Padding="8,2,4,2"
      FontSize="11"
      Foreground="{DynamicResource TrackListItemForegroundBrush}"
      Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextWrapping="Wrap" />
  </Grid>

</UserControl>
