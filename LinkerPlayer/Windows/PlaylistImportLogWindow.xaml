<Window x:Class="LinkerPlayer.Windows.PlaylistImportLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="500"
        MinHeight="220"
        Closing="Window_Closing">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Summary banner -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Summary}"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#A0A0A0"
                   Margin="4,4,4,8" />

        <DataGrid Grid.Row="1"
                  x:Name="LogList"
                  ItemsSource="{Binding Entries}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="None"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  CanUserSortColumns="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  PreviewKeyDown="LogList_PreviewKeyDown"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="#1E1E1E"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#242424"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#264F78" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- Action label -->
                <DataGridTemplateColumn Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ActionLabel}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0A0A0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActionLabel}" Value="Recovered">
                                                <Setter Property="Foreground" Value="#4EC94E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionLabel}" Value="Missing">
                                                <Setter Property="Foreground" Value="#E05252" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionLabel}" Value="Skipped">
                                                <Setter Property="Foreground" Value="#E0B040" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Detail -->
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Detail}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#D4D4D4"
                                       ToolTip="{Binding Path}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Width="80" Height="28" Margin="4" Click="CopyAll_Click">Copy All</Button>
            <Button Width="70" Height="28" Margin="4" Click="Close_Click">Close</Button>
        </StackPanel>
    </Grid>
</Window>
