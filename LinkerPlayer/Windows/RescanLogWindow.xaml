<Window x:Class="LinkerPlayer.Windows.RescanLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LinkerPlayer.Models"
        Title="Rescan Log"
        Width="750"
        Height="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="450"
        MinHeight="200"
        Closing="Window_Closing">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="LogList"
                  Grid.Row="0"
                  ItemsSource="{Binding Entries}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="None"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  CanUserSortColumns="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  PreviewKeyDown="LogList_PreviewKeyDown"
                  ScrollViewer.ScrollChanged="LogList_ScrollChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="#1E1E1E"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#242424"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#264F78" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- Timestamp -->
                <DataGridTemplateColumn Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:RescanLogEntry}">
                            <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#606060" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Action label -->
                <DataGridTemplateColumn Width="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:RescanLogEntry}">
                            <TextBlock Text="{Binding ActionLabel}"
                                       FontFamily="Consolas" FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0A0A0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Added}">
                                                <Setter Property="Foreground" Value="#4EC94E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Removed}">
                                                <Setter Property="Foreground" Value="#E05252" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Updated}">
                                                <Setter Property="Foreground" Value="#5AACF0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Warning}">
                                                <Setter Property="Foreground" Value="#E0B040" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Detail -->
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:RescanLogEntry}">
                            <TextBlock Text="{Binding Detail}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#D4D4D4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Spinner — visible while scanning -->
            <TextBlock x:Name="SpinnerText"
                       FontFamily="Consolas"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#5AACF0"
                       VerticalAlignment="Center"
                       Margin="4,0,12,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="#808080"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ClearButton" Width="70" Height="28" Margin="4" Click="Clear_Click">Clear</Button>
            <Button Width="80" Height="28" Margin="4" Click="CopyAll_Click">Copy All</Button>
            <Button Width="70" Height="28" Margin="4" Click="Close_Click">Close</Button>
        </StackPanel>
    </Grid>
</Window>
