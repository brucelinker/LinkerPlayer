<Window x:Class="LinkerPlayer.Windows.RescanLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LinkerPlayer.Models"
        Title="Rescan Log"
        Width="750"
        Height="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="450"
        MinHeight="200"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="DetailStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize"   Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <ListView x:Name="LogList"
                  Grid.Row="0"
                  ItemsSource="{Binding Entries}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="#1E1E1E"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:RescanLogEntry}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Timestamp -->
                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="#606060" Width="56" />
                        <!-- Action label — foreground chosen via trigger -->
                        <TextBlock Text="{Binding ActionLabel}"
                                   FontFamily="Consolas" FontSize="12"
                                   FontWeight="SemiBold" Width="68">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A0A0A0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Added}">
                                            <Setter Property="Foreground" Value="#4EC94E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Removed}">
                                            <Setter Property="Foreground" Value="#E05252" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Updated}">
                                            <Setter Property="Foreground" Value="#5AACF0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Action}" Value="{x:Static models:RescanAction.Warning}">
                                            <Setter Property="Foreground" Value="#E0B040" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Detail -->
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DetailStyle}" Foreground="#D4D4D4" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Spinner — visible while scanning -->
            <TextBlock x:Name="SpinnerText"
                       FontFamily="Consolas"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#5AACF0"
                       VerticalAlignment="Center"
                       Margin="4,0,12,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="#808080"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ClearButton" Width="70" Height="28" Margin="4" Click="Clear_Click">Clear</Button>
            <Button Width="70" Height="28" Margin="4" Click="Close_Click">Close</Button>
        </StackPanel>
    </Grid>
</Window>
